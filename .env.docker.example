# Server Configuration
PORT=3000
NODE_ENV=production

# URLs
# Frontend URL (host port 5173 by default)
CLIENT_URL=http://localhost:5173
# Backend URL (host port 3000 by default)
BACKEND_URL=http://localhost:3000

# Database & Cache Connections
# Note: In docker-compose, 'host.docker.internal' connects to databases running on your host machine.
# If running with --profile full, you can use: mongodb://mongo:27017/auth_db
MONGO_URL=mongodb://host.docker.internal:27017/auth_db
REDIS_URL=redis://:yourpassword@host.docker.internal:6379

