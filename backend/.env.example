# CRM Environment Variables Example
PORT=3000
MONGO_URL=mongodb://localhost:27017/auth_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=your_jwt_secret_here

CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Meta (Facebook & Instagram) Graph API Webhook Setup
# 1. META_VERIFY_TOKEN: A custom secret string that matches the Verify Token in Meta App Dashboard > Webhooks.
META_VERIFY_TOKEN=crm_meta_webhook_secret_token

# 2. META_PAGE_ACCESS_TOKEN: Long-lived Facebook Page Access Token with `leads_retrieval` and `pages_read_engagement` permissions.
META_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
